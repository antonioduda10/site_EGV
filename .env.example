POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:REPLACE_LOCAL_DB_PASSWORD@localhost:5433/portal_egv?schema=public
NEXTAUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Em rede local, use o IP/host atual do servidor (ex.: http://10.90.232.8:3000)
NEXTAUTH_URL=http://localhost:3000
UPLOAD_DIR=./uploads
ERROR_LOG_DIR=./logs
# Production-only PostgreSQL and image variables are documented without secrets
# in deploy/production.env.example. Do not copy local .env files to the VPS.
