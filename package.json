{
  "name": "portal-egv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node tools/check-node.cjs",
    "prebuild": "node tools/check-node.cjs",
    "prestart": "node tools/check-node.cjs",
    "pretest": "node tools/check-node.cjs",
    "prevalidate": "node tools/check-node.cjs",
    "pretest:e2e": "node tools/check-node.cjs",
    "security:audit": "tsx tools/security/audit.ts",
    "security:package": "tsx tools/security/package.ts",
    "deploy:package": "tsx deploy/package.ts",
    "deploy:publish": "tsx deploy/publish.ts",
    "deploy:ui-check": "tsx deploy/ui-smoke.ts",
    "dev:secure-users": "tsx tools/development/secure-users.ts",
    "dev:enable-alerts": "tsx tools/development/enable-alerts.ts",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:evidence": "tsx tests/evidence.ts",
    "validate": "tsx tests/validate.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --skip-seed",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "file-type": "22.2.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "quill": "^2.0.3",
    "quill-image-resize-module": "^3.0.0",
    "quill-image-resize-module-ts": "^3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-quill": "^2.0.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "zod": "3.23.8"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "postcss": "$postcss",
    "eslint-config-next": {
      "@typescript-eslint/parser": "8.46.4",
      "@typescript-eslint/eslint-plugin": "8.46.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.13",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/sanitize-html": "2.16.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "fflate": "0.8.3",
    "postcss": "8.5.31",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.7",
    "tsx": "4.16.5",
    "typescript": "5.5.4",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
