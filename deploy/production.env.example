# Server-only configuration: copy to /opt/portal-egv/shared/.env with mode 0600.
POSTGRES_DB=portal_egv
POSTGRES_USER=portal_bootstrap
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
DATABASE_URL=postgresql://portal_egv:APP_PASSWORD@db:5432/portal_egv?schema=public&connection_limit=5&pool_timeout=20
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
NEXTAUTH_URL=http://YOUR_SERVER_IP
PORTAL_HOST=YOUR_SERVER_IP
# Required only when enabling compose.https.yml, after validating both names.
PORTAL_WWW_HOST=www.YOUR_SCHOOL_DOMAIN
PORTAL_IMAGE=portal-egv:YOUR_RELEASE
