# Configure only on the VPS: /opt/portal-egv/shared/r2.env (root:root, 0600).
# Docker env-file format: plain values, no shell quotes or export statements.
RESTIC_REPOSITORY=s3:https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/YOUR_PRIVATE_BUCKET/portal-egv
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET_KEY
AWS_DEFAULT_REGION=auto
